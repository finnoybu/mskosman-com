---
/**
 * A card on a browsing page: a grade, a course or a subject, with a note on
 * the right (usually the lesson count). Without `href` it renders as a plain,
 * muted box for something that has no lessons yet.
 */
interface Props {
  title: string;
  note: string;
  hue: number;
  href?: string;
}

const { title, note, hue, href } = Astro.props;
const Tag = href ? 'a' : 'div';
const hueVars = [
  `--card-light-fg: var(--sol-h${hue}-light-fg)`,
  `--card-light-bg: var(--sol-h${hue}-light-bg)`,
  `--card-dark-fg: var(--sol-h${hue}-dark-fg)`,
  `--card-dark-bg: var(--sol-h${hue}-dark-bg)`,
].join('; ');
---

<Tag
  href={href}
  class:list={[
    'browse-card flex items-center min-w-0 p-5 sm:p-6 rounded-lg border border-border transition-all bg-white dark:bg-gray-800',
    !href && 'browse-card--empty',
  ]}
  style={hueVars}
>
  <div class="flex w-full items-center justify-between gap-3">
    <h3 class="min-w-0 text-lg sm:text-xl font-semibold text-gray-900 dark:text-gray-100">
      {title}
    </h3>
    <span class="shrink-0 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
      {note}
    </span>
  </div>
</Tag>

<style>
  a.browse-card:hover {
    border-color: var(--card-light-fg);
    box-shadow: 0 4px 12px var(--card-light-bg);
  }
  :root[data-theme='dark'] a.browse-card:hover {
    border-color: var(--card-dark-fg);
    box-shadow: 0 4px 12px var(--card-dark-bg);
  }
  .browse-card--empty {
    border-style: dashed;
  }
  .browse-card--empty h3 {
    font-weight: 500;
    opacity: 0.75;
  }
</style>
