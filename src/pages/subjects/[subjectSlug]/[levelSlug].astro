---
import MainLayout from '@layouts/MainLayout.astro';
import LessonCard from '@components/LessonCard.astro';
import { getCollection } from 'astro:content';
import { SUBJECTS, SUBJECT_SLUGS } from '@lib/constants';
import { lessonCountLabel, lessonsAt, levelPath, subjectLevels } from '@lib/levels';

// One page per subject and grade (or course) that has lessons
export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');

  return SUBJECTS.flatMap((subject) =>
    subjectLevels(subject)
      .map((level) => ({ level, lessons: lessonsAt(allLessons, subject, level) }))
      .filter(({ lessons }) => lessons.length > 0)
      .map(({ level, lessons }) => ({
        params: { subjectSlug: SUBJECT_SLUGS[subject], levelSlug: level.slug },
        props: { subject, level, lessons },
      }))
  );
}

const { subject, level, lessons } = Astro.props;

// A course name already says the subject ("Computer Science Foundations")
const heading = level.kind === 'course' ? level.label : `${level.label} ${subject}`;
const canonicalUrl = `https://mskosman.com${levelPath(subject, level)}`;
---

<MainLayout
  title={`${heading} Lesson Plans | mskosman.com`}
  description={`${lessonCountLabel(lessons.length)} for ${heading}, aligned to Virginia SOL standards`}
  canonical={canonicalUrl}
>
  <div class="max-w-6xl mx-auto">
    <div class="mb-8">
      <a
        href={`/subjects/${SUBJECT_SLUGS[subject]}`}
        class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 mb-4 inline-block"
      >
        ← Back to {subject}
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        {heading}
      </h1>
      <p class="text-gray-600 dark:text-gray-300">
        {lessonCountLabel(lessons.length)}, in teaching order
      </p>
    </div>

    <LessonCard lessons={lessons} hoverBy="grade" />
  </div>
</MainLayout>
