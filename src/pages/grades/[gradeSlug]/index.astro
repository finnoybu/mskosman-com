---
import MainLayout from '@layouts/MainLayout.astro';
import BrowseCard from '@components/BrowseCard.astro';
import { getCollection } from 'astro:content';
import { GRADES, GRADE_LABELS, SUBJECTS, SUBJECT_HUES, SUBJECT_SLUGS } from '@lib/constants';
import { gradeLevel, lessonCountLabel, lessonsAt } from '@lib/levels';

export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');
  const allStandards = await getCollection('standards');

  return GRADES.map((grade) => {
    // Subjects that have lessons for this grade, alphabetically
    const subjects = [...SUBJECTS]
      .sort((a, b) => a.localeCompare(b))
      .map((subject) => ({ subject, count: lessonsAt(allLessons, subject, gradeLevel(grade)).length }))
      .filter(({ count }) => count > 0);

    return {
      params: { gradeSlug: grade },
      props: {
        grade,
        subjects,
        total: subjects.reduce((sum, { count }) => sum + count, 0),
        standards: allStandards.filter((standard) => standard.data.grade === grade),
      },
    };
  });
}

const { grade, subjects, total, standards } = Astro.props;

// Generate canonical URL
const canonicalUrl = `https://mskosman.com/grades/${grade}`;
---

<MainLayout
  title={`${GRADE_LABELS[grade]} Lesson Plans | mskosman.com`}
  description={`Explore ${total} ${GRADE_LABELS[grade]} lesson plans aligned to Virginia SOL standards`}
  canonical={canonicalUrl}
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <a
        href="/grades"
        class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 mb-4 inline-block"
      >
        ← Back to Grades
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        {GRADE_LABELS[grade]}
      </h1>
      <p class="text-gray-600 dark:text-gray-300">
        {lessonCountLabel(total)} available
      </p>
    </div>

    {standards.length > 0 && (
      <div class="mb-8 p-6 rounded-lg bg-blue-50 dark:bg-blue-950/20 border border-blue-200 dark:border-blue-900">
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
          Standards & Resources
        </h2>
        <p class="text-gray-700 dark:text-gray-300 mb-4">
          View Virginia SOL standards and instructional resources for {GRADE_LABELS[grade]}:
        </p>
        <div class="space-y-4">
          {standards.map((standard) => (
            <div class="p-4 rounded bg-white dark:bg-gray-800 border border-blue-200 dark:border-blue-900">
              <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">
                {standard.data.subject}
                {standard.data.strand && ` - ${standard.data.strand}`}
              </h3>
              
              {standard.data.solCodes && standard.data.solCodes.length > 0 && (
                <div class="mb-2">
                  <span class="text-sm font-medium text-gray-700 dark:text-gray-300">SOL Codes: </span>
                  <span class="text-sm text-gray-600 dark:text-gray-400">
                    {standard.data.solCodes.join(', ')}
                  </span>
                </div>
              )}

              {standard.data.solDocLinks.length > 0 && (
                <div class="mb-2">
                  <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Documents:</p>
                  <ul class="text-sm space-y-1 ml-4">
                    {standard.data.solDocLinks.map((link) => (
                      <li>
                        <a
                          href={link.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
                        >
                          {link.label} →
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              {standard.data.instructionalResources && standard.data.instructionalResources.length > 0 && (
                <div>
                  <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Instructional Resources:</p>
                  <ul class="text-sm space-y-1 ml-4">
                    {standard.data.instructionalResources.map((resource) => (
                      <li>
                        <a
                          href={resource.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
                        >
                          {resource.label} →
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {subjects.length > 0 ? (
      <section aria-labelledby="by-subject">
        <h2 id="by-subject" class="text-2xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
          By subject
        </h2>
        <div class="grid gap-4 md:grid-cols-2">
          {subjects.map(({ subject, count }) => (
            <BrowseCard
              title={subject}
              note={lessonCountLabel(count)}
              hue={SUBJECT_HUES[subject]}
              href={`/grades/${grade}/${SUBJECT_SLUGS[subject]}`}
            />
          ))}
        </div>
      </section>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">
          No lessons available yet for this grade.
        </p>
      </div>
    )}
  </div>
</MainLayout>
