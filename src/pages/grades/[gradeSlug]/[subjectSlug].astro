---
import MainLayout from '@layouts/MainLayout.astro';
import LessonCard from '@components/LessonCard.astro';
import { getCollection } from 'astro:content';
import { GRADES, SUBJECTS, SUBJECT_SLUGS } from '@lib/constants';
import { gradeLevel, lessonCountLabel, lessonsAt, levelPath } from '@lib/levels';

// Grade first, then subject: the same lesson list as /subjects/{subject}/{grade},
// reached the other way round. The canonical address is the subject one.
export async function getStaticPaths() {
  const allLessons = await getCollection('lessons');

  return GRADES.flatMap((grade) =>
    SUBJECTS.map((subject) => ({ subject, lessons: lessonsAt(allLessons, subject, gradeLevel(grade)) }))
      .filter(({ lessons }) => lessons.length > 0)
      .map(({ subject, lessons }) => ({
        params: { gradeSlug: grade, subjectSlug: SUBJECT_SLUGS[subject] },
        props: { grade, subject, lessons },
      }))
  );
}

const { grade, subject, lessons } = Astro.props;

const level = gradeLevel(grade);
const heading = `${level.label} ${subject}`;
const canonicalUrl = `https://mskosman.com${levelPath(subject, level)}`;
---

<MainLayout
  title={`${heading} Lesson Plans | mskosman.com`}
  description={`${lessonCountLabel(lessons.length)} for ${heading}, aligned to Virginia SOL standards`}
  canonical={canonicalUrl}
>
  <div class="max-w-6xl mx-auto">
    <div class="mb-8">
      <a
        href={`/grades/${grade}`}
        class="text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 mb-4 inline-block"
      >
        ← Back to {level.label}
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-2">
        {heading}
      </h1>
      <p class="text-gray-600 dark:text-gray-300">
        {lessonCountLabel(lessons.length)}, in teaching order
      </p>
    </div>

    <LessonCard lessons={lessons} hoverBy="subject" />
  </div>
</MainLayout>
